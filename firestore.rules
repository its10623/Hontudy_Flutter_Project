rules_version = '2';

// 혼터디 Firestore 보안 규칙
// - 앱은 로그인한 본인의 users/{uid} 문서와 그 하위 컬렉션만 읽고 쓴다.
//   (약관 동의 여부, diagnosisProfile, solvedRecord)
// - aiUsage(사용자별 하루 AI 호출 카운터)는 Cloud Functions가 Admin SDK로만 쓰므로
//   앱에서는 접근할 수 없다. Admin SDK는 보안 규칙의 영향을 받지 않는다.
// - 여기에 명시하지 않은 경로는 모두 거부된다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
