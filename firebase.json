{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hontudy",
          "appId": "1:188081935203:android:943a45318d138a29e67956",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "hontudy",
          "appId": "1:188081935203:ios:0efa5957038d9bc7e67956",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hontudy",
          "configurations": {
            "android": "1:188081935203:android:943a45318d138a29e67956",
            "ios": "1:188081935203:ios:0efa5957038d9bc7e67956",
            "web": "1:188081935203:web:62edbfa3c14b07c9e67956"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
